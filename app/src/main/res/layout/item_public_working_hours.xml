<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingVertical="7dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/tv_public_day" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/trackster_navy" android:textStyle="bold" />
        <TextView android:id="@+id/tv_public_hours" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/trackster_blue_dark" />
    </LinearLayout>
    <TextView android:id="@+id/tv_public_break" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="end" android:textColor="@color/trackster_text_secondary" android:textSize="12sp" android:visibility="gone" />
</LinearLayout>
