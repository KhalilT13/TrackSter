<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/trackster_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/action_back"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/trackster_blue_dark" />

        <TextView
            android:id="@+id/tv_booking_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/booking_title"
            android:textColor="@color/trackster_blue_dark"
            android:fontFamily="sans-serif-medium"
            android:textSize="26sp" />

        <!-- Which business we're booking with (set at runtime). -->
        <TextView
            android:id="@+id/tv_business_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/trackster_text_secondary"
            android:textSize="14sp"
            tools:text="Sharp Cuts Barber Shop" />

        <TextView
            android:id="@+id/tv_booking_availability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_info_banner"
            android:padding="12dp"
            android:text="@string/booking_loading_availability"
            android:textColor="@color/trackster_text_secondary"
            android:textSize="13sp" />

        <!-- Step 1: service -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/booking_step_service"
            android:textColor="@color/trackster_navy"
            android:fontFamily="sans-serif-medium"
            android:textSize="17sp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/service_chip_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:selectionRequired="false"
            app:singleSelection="true" />

        <!-- Step 2: date -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/booking_step_date"
            android:textColor="@color/trackster_navy"
            android:fontFamily="sans-serif-medium"
            android:textSize="17sp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/date_chip_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:selectionRequired="false"
            app:singleSelection="true" />

        <!-- Step 3: time -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/booking_step_time"
            android:textColor="@color/trackster_navy"
            android:fontFamily="sans-serif-medium"
            android:textSize="17sp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/time_chip_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:selectionRequired="false"
            app:singleSelection="true" />

        <!-- Summary of the current selections -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/trackster_card"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/trackster_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/booking_summary_title"
                    android:textColor="@color/trackster_blue_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/booking_summary_service"
                        android:textColor="@color/trackster_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_summary_service"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/trackster_navy"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="Haircut" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/booking_summary_price"
                        android:textColor="@color/trackster_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_summary_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/trackster_navy"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="₪50" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/booking_summary_date"
                        android:textColor="@color/trackster_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_summary_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/trackster_navy"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="Thu, Jul 9" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/booking_summary_time"
                        android:textColor="@color/trackster_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_summary_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/trackster_navy"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="10:30" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Book button with an overlaid spinner (shown while the Firestore work runs). -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_book_appointment"
                style="@style/Trackster.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/trackster_blue"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="@string/action_book_appointment"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:cornerRadius="16dp" />

            <ProgressBar
                android:id="@+id/progress_booking"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="16dp"
                android:indeterminateTint="@color/white"
                android:visibility="gone"
                tools:visibility="visible" />

        </FrameLayout>

    </LinearLayout>

</ScrollView>
