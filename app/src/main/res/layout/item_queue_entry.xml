<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Trackster.Card.Surface"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/trackster_card"
    app:cardCornerRadius="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Circular badge showing this entry's queue number (e.g. "#1"). -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="14dp"
                app:cardBackgroundColor="@color/trackster_blue_light"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/tv_queue_number"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@color/trackster_blue"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="#1" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_customer_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/trackster_navy"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Khalil Talhami" />

                <TextView
                    android:id="@+id/tv_service_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/trackster_text_secondary"
                    android:textSize="13sp"
                    tools:text="Haircut" />

                <!-- "date · time" line; hidden when the record has neither. -->
                <TextView
                    android:id="@+id/tv_schedule"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/trackster_blue_dark"
                    android:textSize="13sp"
                    tools:text="Thu, Jul 9 · 10:30" />

            </LinearLayout>

            <!-- Pill background is recolored per status in QueueEntryAdapter. -->
            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_status_pill"
                android:backgroundTint="@color/trackster_blue_light"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:textColor="@color/trackster_blue"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Waiting" />

        </LinearLayout>

        <!-- Filled action, shown only on the next-up waiting entry. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_call_next"
            style="@style/Trackster.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/trackster_blue"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/action_call_next"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:visibility="gone"
            app:cornerRadius="14dp"
            tools:visibility="visible" />

        <!-- Outlined action, shown only on in-service entries. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_complete"
            style="@style/Trackster.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/action_complete"
            android:textAllCaps="false"
            android:textColor="@color/trackster_blue"
            android:textSize="13sp"
            android:visibility="gone"
            app:cornerRadius="14dp"
            app:strokeColor="@color/trackster_blue"
            tools:visibility="visible" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
