<?xml version="1.0" encoding="utf-8"?>
<!--
    MainActivity hosts the app. The FragmentContainerView is the single slot
    that whichever screen is active gets swapped into. The BottomNavigationView
    sits beneath it and is only made visible after login (see MainActivity);
    while it's GONE (during Landing / Sign In / Sign Up) the container fills the
    whole screen thanks to the layout_weight.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/trackster_surface"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:layout="@layout/fragment_landing" />

        <ProgressBar
            android:id="@+id/progress_startup"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/trackster_blue"
            android:visibility="gone"
            tools:visibility="visible" />

    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:background="@color/trackster_card"
        android:elevation="12dp"
        android:visibility="gone"
        app:backgroundTint="@color/trackster_card"
        app:itemActiveIndicatorStyle="@style/Trackster.BottomNav.ActiveIndicator"
        app:itemIconTint="@color/bottom_nav_item_color"
        app:itemHorizontalTranslationEnabled="false"
        app:itemIconSize="23dp"
        app:itemPaddingBottom="8dp"
        app:itemPaddingTop="8dp"
        app:itemRippleColor="@color/trackster_blue_light"
        app:itemTextColor="@color/bottom_nav_item_color"
        app:labelVisibilityMode="labeled"
        tools:visibility="visible" />

</LinearLayout>
