<?xml version="1.0" encoding="utf-8"?>
<!-- Choice chip fill: light blue when selected, white otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/trackster_blue_light" android:state_checked="true" />
    <item android:color="@color/trackster_card" android:state_checked="false" />
</selector>
