    <string name="privacy_title">Privacy policy</string>
    <string name="privacy_effective_date">Effective: August 14, 2026</string>
    <string name="privacy_information_title">Information we collect</string>
    <string name="privacy_information_body">Trackster stores the account information you provide, including name, email address and account role. Business owners may publish a business name, services, prices, working hours, location, accessibility features, logo and photos. Appointment, queue, favorite and review information is stored when you use those features.</string>
    <string name="privacy_use_title">How information is used</string>
    <string name="privacy_use_body">Information is used only to authenticate accounts, display business listings, schedule and manage appointments, operate live queues, show reviews and deliver requested appointment and queue reminders. Calendar events are created only after you choose Add to calendar and confirm them in your calendar application. Trackster does not sell personal information and does not process payments.</string>
    <string name="privacy_storage_title">Storage and security</string>
    <string name="privacy_storage_body">Trackster uses Google Firebase Authentication, Cloud Firestore and Cloud Storage. Access is restricted through Firebase security rules based on the signed-in account and its role. No online system can guarantee absolute security, so users should use a unique password and protect their device.</string>
    <string name="privacy_sharing_title">Sharing</string>
    <string name="privacy_sharing_body">Public business information, availability, accessibility features and customer reviews are visible to signed-in users. Appointment details are limited to the customer and the relevant business. Data may be processed by Google Firebase as the application infrastructure provider.</string>
    <string name="privacy_controls_title">Your choices</string>
    <string name="privacy_controls_body">You can change optional business information, photos, schedules and accessibility details; disable notifications in device settings; reschedule or cancel eligible appointments; and sign out at any time. For account deletion or correction requests, contact the project administrator.</string>
    <string name="accessibility_statement_title">Accessibility statement</string>
    <string name="accessibility_statement_body">Trackster supports scalable text, screen-reader labels, large touch targets, RTL layouts and system light/dark appearance. Business accessibility details are supplied by each business and should be confirmed directly when accommodation is important.</string>
    <string name="privacy_contact_title">Contact</string>
    <string name="privacy_contact_body">Trackster is a classroom project. Privacy, accessibility, correction and deletion questions should be directed to the project administrator or instructor.</string>

