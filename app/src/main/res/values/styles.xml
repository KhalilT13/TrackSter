<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Light-blue pill behind the selected bottom-nav tab, to match the app's blue branding
         instead of the default Material purple. -->
    <style name="Trackster.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/trackster_blue_light</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Trackster.Pill</item>
    </style>

    <style name="ShapeAppearance.Trackster.Pill" parent="ShapeAppearance.Material3.Corner.Full" />

    <style name="Trackster.Card.Surface" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/trackster_card</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeColor">@color/trackster_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Trackster.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">54dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/trackster_blue</item>
        <item name="cornerRadius">16dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Trackster.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">54dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/trackster_blue</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/trackster_blue</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Trackster.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/trackster_card</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/trackster_blue</item>
        <item name="hintTextColor">@color/trackster_text_secondary</item>
    </style>

    <style name="Trackster.Text.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/trackster_navy</item>
        <item name="android:textSize">26sp</item>
    </style>

    <style name="Trackster.Text.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/trackster_navy</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Trackster.Text.BodySecondary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/trackster_text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Single-select choice chip used for service / date / time on the booking screen.
         Selected = light blue fill + blue text (see chip_bg_color / chip_text_color). -->
    <style name="Trackster.Chip.Choice" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg_color</item>
        <item name="android:textColor">@color/chip_text_color</item>
        <item name="chipStrokeColor">@color/trackster_outline</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">12dp</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:textStyle">bold</item>
        <!-- Hide the leading check so selecting a chip doesn't shift its text. -->
        <item name="checkedIconVisible">false</item>
    </style>

</resources>
